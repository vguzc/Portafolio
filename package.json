{
  "name": "portafolio-personal",
  "version": "1.0.0",
  "description": "Portafolio Personal y Pruebas Unitarias con Jasmine y Karma - Duoc UC",
  "main": "src/index.js",
  "scripts": {
    "start": "webpack serve --mode development --open",
    "build": "webpack --mode production",
    "test": "karma start karma.conf.js --single-run",
    "test:watch": "karma start karma.conf.js",
    "test:coverage": "karma start karma.conf.js --single-run --reporters spec,coverage"
  },
  "keywords": [
    "react",
    "bootstrap",
    "portfolio",
    "jasmine",
    "karma",
    "unit-testing",
    "duoc-uc"
  ],
  "author": "Vicente Guzmán",
  "license": "MIT",
  "dependencies": {
    "bootstrap": "^5.3.3",
    "bootstrap-icons": "^1.11.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.4",
    "@babel/preset-env": "^7.24.4",
    "@babel/preset-react": "^7.24.1",
    "@testing-library/dom": "^9.3.4",
    "@testing-library/react": "^14.3.1",
    "babel-loader": "^9.1.3",
    "babel-plugin-istanbul": "^7.0.0",
    "copy-webpack-plugin": "^12.0.2",
    "css-loader": "^6.10.0",
    "html-webpack-plugin": "^5.6.0",
    "jasmine-core": "^5.1.2",
    "karma": "^6.4.3",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-spec-reporter": "^0.0.36",
    "karma-webpack": "^5.0.1",
    "style-loader": "^3.3.4",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.4"
  }
}
